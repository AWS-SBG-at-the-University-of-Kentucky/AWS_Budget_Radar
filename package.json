{
  "name": "aws-budget-radar",
  "version": "0.1.0",
  "description": "Clone-and-deploy AWS CDK safeguard for personal learning accounts: when a cost budget is breached, it blocks selected creation/start operations by your configured IAM identities and emails a region-wide inventory of what's running. Read-only reporter; never stops or deletes resources; not a hard cap.",
  "repository": {
    "type": "git",
    "url": "https://github.com/AWS-SBG-at-the-University-of-Kentucky/AWS_Budget_Radar.git"
  },
  "license": "MIT",
  "bin": {
    "budget-radar": "bin/budget-radar.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "synth": "cdk synth",
    "preflight": "ts-node preflight.ts",
    "deploy": "ts-node preflight.ts && cdk deploy",
    "verify": "ts-node verify.ts"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "aws-cdk": "^2.160.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@aws-sdk/client-budgets": "^3.600.0",
    "@aws-sdk/client-iam": "^3.600.0",
    "@aws-sdk/client-sns": "^3.1133.0",
    "@aws-sdk/client-sts": "^3.600.0",
    "aws-cdk-lib": "^2.160.0",
    "constructs": "^10.3.0",
    "dotenv": "^16.4.5"
  }
}
