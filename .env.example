# --- AWS Budget Radar configuration (the only file you edit) ---
# Left empty on purpose — a real-looking placeholder here would spam a
# real mailbox if you forget to change it. Required; loadConfig() fails
# closed (refuses to deploy) if this isn't a valid email address.
ALERT_EMAIL=

# Leave EXISTING_BUDGET_NAME empty to have Radar CREATE a monthly USD cost budget (Path B).
# Set it to attach to a budget you already made (Path A) — it must be a monthly
# USD COST budget with no filters/scope; Radar never modifies it.
EXISTING_BUDGET_NAME=

MONTHLY_BUDGET_USD=5          # used only when creating a budget (Path B). 0.01 = first-charge tripwire.
WARN_AT_PERCENT=80            # Path-B-only: extra warn-only email threshold on the budget Radar creates
                               # (email only; never triggers the deny). Ignored on Path A (EXISTING_BUDGET_NAME
                               # set) — Radar never modifies an existing budget's own notifications.

ACTION_THRESHOLD_PERCENT=100
ACTION_THRESHOLD_TYPE=ACTUAL  # or FORECASTED (earlier warning; needs ~5 weeks of billing history)

# true (default) = budget counts GROSS usage: AWS credits & refunds are EXCLUDED,
# so usage trips the budget even while promo credits cover the bill (recommended
# for credit-covered learning accounts). false = net of credits (AWS default);
# credit-covered usage can read ~$0.00 and never trip.
TRACK_GROSS_USAGE=true

SAFETY=watch                  # watch = deny waits for your console approval; armed = auto-apply

# REQUIRED: at least one identity the deny attaches to. Names or full ARNs.
# The root user can never be a target. If an identity lives under a non-root
# IAM path (not "/"), you MUST use its full ARN here, not a bare name — the
# preflight will reject a bare name that resolves to a non-root path.
IAM_DENY_TARGET_USERS=your-iam-username
IAM_DENY_TARGET_GROUPS=
IAM_DENY_TARGET_ROLES=

# REQUIRED: a full IAM ARN for a principal that can reverse the action / detach
# the deny (your recovery route). Must NOT also be a deny target.
RECOVERY_PRINCIPAL_ARN=arn:aws:iam::<account-id>:role/YourAdminRole

# Optional warn-only per-service budgets (no blocking action). Exact AWS
# service display names, colon, USD limit, comma-separated.
# e.g. Amazon Elastic Compute Cloud - Compute:20,Amazon SageMaker:10
SERVICE_BUDGETS=

# Optional: AWS service display names to EXCLUDE from the main (action-enabled)
# budget, comma-separated, exact SERVICE names. EMPTY by default, which keeps the
# budget protecting your TOTAL account cost (recommended). Setting this SCOPES the
# budget to "everything except these services", so excluded spend no longer trips
# it — use sparingly. Common example: exclude "AWS Cost Explorer" so the metered
# cost of *checking* your costs ($0.01/Cost Explorer request) doesn't itself trip
# a tiny tripwire (there is nothing to shut down for that spend anyway).
# e.g. EXCLUDE_SERVICES=AWS Cost Explorer
EXCLUDE_SERVICES=
